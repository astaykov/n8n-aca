{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "resourceGroupName": {
      "value": "${AZURE_RESOURCE_GROUP}"
    },
    "location": {
      "value": "northeurope"
    },
    "swaLocation": {
      "value": "westeurope"
    },
    "openAiLocation": {
      "value": "eastus2"
    },    
    "n8nImage": {
      "value": "ghcr.io/n8n-io/n8n:2.25.7"
    },
    "cpuCores": {
      "value": "1"
    },
    "memorySize": {
      "value": "2Gi"
    },
    "n8nAdminEmail": {
      "value": "${N8N_ADMIN_EMAIL}"
    },
    "n8nAdminPassword": {
      "value": "${N8N_ADMIN_PASSWORD}"
    },
    "fileShareName": {
      "value": "n8ndata"
    },
    "openAiDeploymentName": {
      "value": "gpt-5.4-nano"
    },
    "openAiModelName": {
      "value": "gpt-5.4-nano"
    },
    "openAiModelVersion": {
      "value": "2026-03-17"
    },
    "openAiDeploymentSku": {
      "value": "GlobalStandard"
    },
    "openAiTpmCapacity": {
      "value": 50
    }
  }
}
